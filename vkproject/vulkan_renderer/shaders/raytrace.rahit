#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable
#include "common.glsl"

hitAttributeEXT vec2 attribs;

layout(location = 0) rayPayloadInEXT hitPayload prd;
layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;

layout(std430, set = 0, binding = 1) buffer ObjectInfo_
{
    ObjectInfo object_info[];
};
layout(std430, set = 0, binding = 2) buffer MaterialIndices
{
    uint material_indices[];
};
layout(std430, set = 0, binding = 3) buffer Indices
{
    uint indices[];
};
layout(std430, set = 0, binding = 4) buffer Positions
{
        vec4 positions[];
};
layout(std430, set = 0, binding = 5) buffer UVs
{
    vec2 uvs[];
};
layout(std430, set = 0, binding = 6) buffer Materials
{
    Material materials[];
};

layout(set = 0, binding = 7) uniform sampler2D diffuse_textures[256];
layout(set = 0, binding = 8) uniform sampler2D roughness_textures[256];
layout(set = 0, binding = 9) uniform sampler2D metalness_textures[256];
layout(set = 0, binding = 10) uniform sampler2D normal_textures[256];

mat3 BuildTBN(vec3 p0, vec3 p1, vec3 p2, vec2 uv0, vec2 uv1, vec2 uv2, vec3 n)
{
    vec3 dp1 = p1 - p0;
    vec3 dp2 = p2 - p0;
    vec2 duv1 = uv1 - uv0;
    vec2 duv2 = uv2 - uv0;
    float denom = duv1.x * duv2.y - duv1.y * duv2.x;
    if (abs(denom) < 1e-8)
    {
        vec3 tangent = normalize(perpendicular(n));
        vec3 bitangent = normalize(cross(n, tangent));
        return mat3(tangent, bitangent, n);
    }

    float inv_denom = 1.0 / denom;
    vec3 tangent = normalize((dp1 * duv2.y - dp2 * duv1.y) * inv_denom);
    tangent = normalize(tangent - n * dot(n, tangent));
    vec3 bitangent = normalize(cross(n, tangent));
    return mat3(tangent, bitangent, n);
}

void main()
{
    // Barycentrics from triangle hit attributes
    vec3 barycentrics = vec3(1.0 - attribs.x - attribs.y, attribs.x, attribs.y);

    uint prim_base = object_info[gl_InstanceCustomIndexEXT].starting_primitive + gl_PrimitiveID;
    uint index_offset = prim_base * 3u;
    uvec3 idx = uvec3(indices[index_offset + 0u], indices[index_offset + 1u], indices[index_offset + 2u])
                + uvec3(object_info[gl_InstanceCustomIndexEXT].starting_vertex);

    uvec3 uv_idx = uvec3(index_offset + 0u, index_offset + 1u, index_offset + 2u);
    vec2 uv0 = uvs[uv_idx.x];
    vec2 uv1 = uvs[uv_idx.y];
    vec2 uv2 = uvs[uv_idx.z];
    vec2 uv = barycentrics.x * uv0 + barycentrics.y * uv1 + barycentrics.z * uv2;
    uint matId = material_indices[prim_base];
    vec3 v0 = positions[idx.x].xyz;
    vec3 v1 = positions[idx.y].xyz;
    vec3 v2 = positions[idx.z].xyz;

    // Apply per-material UV flips
    if (materials[matId].flip_uv_x != 0) uv.x = 1.0 - uv.x;
    if (materials[matId].flip_uv_y != 0) uv.y = 1.0 - uv.y;
    prd.uv = uv;


    int texIdx = int(materials[matId].diffuse_texture_index);
    if (texIdx >= 0 && texIdx < 256)
    {
        float a = texture(diffuse_textures[nonuniformEXT(uint(texIdx))], uv).a;
        float opacity = clamp(materials[matId].opacity, 0.0, 1.0);
        if (a < 0.5 || opacity == 0.0)
        {
            ignoreIntersectionEXT;
        }
    }

    int normalIdx = int(materials[matId].normal_texture_index);
    if (normalIdx >= 0 && normalIdx < 256)
    {
        vec3 geomNormal = normalize(cross(v1 - v0, v2 - v0));
        mat4 model_matrix = object_info[gl_InstanceCustomIndexEXT].model_matrix;
        mat3 normalMatrix = transpose(inverse(mat3(model_matrix)));
        vec3 worldNormal = normalize(normalMatrix * geomNormal);
        mat3 tbn = BuildTBN(v0, v1, v2, uv0, uv1, uv2, worldNormal);
        vec3 normalSample = texture(normal_textures[nonuniformEXT(uint(normalIdx))], uv).xyz * 2.0 - 1.0;
        prd.normal = normalize(tbn * normalSample);
    }
}